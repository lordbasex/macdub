<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  ScreenCaptureKit, Speech, Translation and AVFAudio are gated by TCC prompts. The
	  hardened runtime also needs this entitlement before the microphone prompt can appear:
	  live translation hears the person through it. The app is NOT sandboxed (Developer ID
	  distribution). If you ever target the Mac App Store, add com.apple.security.app-sandbox.
	-->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>

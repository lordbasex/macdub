<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  MacDub needs no special entitlements: ScreenCaptureKit, Speech, Translation and
	  AVFAudio are all gated by TCC prompts, not entitlements. The app is NOT sandboxed
	  (Developer ID distribution). If you ever target the Mac App Store, add
	  com.apple.security.app-sandbox here.
	-->
</dict>
</plist>
